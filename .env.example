# ------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#   copy .env.example .env.local      (Windows)
#   cp .env.example .env.local        (Mac/Linux)
#
# Every variable is OPTIONAL. If one is missing, the app falls
# back to demo mode for that service, so the demo never breaks.
# Never commit .env.local — it is already in .gitignore.
# ------------------------------------------------------------

# --- Supabase (database, email login, file storage) ---
# Supabase dashboard → Project Settings → API
#
# These two also switch on login with an email and a password. One
# dashboard setting goes with them (the README has the detail):
#   Authentication → Providers → Email: enabled, "Confirm email" OFF.
# With confirmations off, signing up logs you straight in and no email
# is ever sent, so there is no SMTP server or template to set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Gemini (document reading, the doubt-clearing chat) ---
# Free key from aistudio.google.com → "Get API key". Used ONLY on the server,
# never sent to the browser (note there is no NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=

# Optional: override which Gemini models are used.
# Small and fast, for the chat assistant:
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Stronger, for reading photos and PDFs of documents:
GEMINI_MODEL_VISION=gemini-3.8-flash

# --- Anthropic Claude (optional alternative for drafting documents) ---
# console.anthropic.com → API Keys. Used ONLY on the server.
ANTHROPIC_API_KEY=

# Optional: override which Claude models are used.
# Fast/cheap model for reading documents, simplifying text and chat:
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Stronger model, used only for drafting legal documents:
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# --- Public site URL (optional) ---
# Where this app is deployed, e.g. https://aasra.example.com. Used to
# make the Open Graph link-preview image URL absolute, which every chat
# app requires. Without it, previews fall back to localhost and will
# not render for anyone else.
NEXT_PUBLIC_SITE_URL=

# --- Razorpay (consultation payments) ---
# TEST MODE ONLY while developing. Dashboard -> Settings -> API Keys, with
# the dashboard's "Test mode" switch ON. A test key id starts rzp_test_.
#
# Leave all three blank and the app still demos end to end: the payment
# step becomes a clearly labelled "Test payment (no gateway configured)"
# screen with a button that marks the consultation paid, so a judge can
# walk the whole flow without any account anywhere.
#
# The secret is server-only. It has no NEXT_PUBLIC_ prefix, so it is
# never sent to the browser, and it is the only thing that can sign or
# verify a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The SAME key id again, for the browser's checkout widget. Only the id,
# never the secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- WhatsApp contact (optional) ---
# The number families reach when a consultation cannot be recorded.
# Country code, no "+", no spaces or dashes: +91 98200 12345 becomes
# 919820012345.
#
# Leave it blank and nothing breaks. The app hides every WhatsApp link
# and offers the in-app consultation flow instead, rather than opening
# WhatsApp to a number that does not answer.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# How that number should be shown to a person, e.g. "+91 98200 12345".
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# --- Supabase service role (optional, server only) ---
# Dashboard -> Project Settings -> API -> service_role.
#
# Only used by the payment verification route, and only to write the
# "paid" flag. With it set, that write bypasses Row Level Security and is
# authoritative. Without it, the route forwards the signed-in family's
# own access token instead, which also works.
#
# NEVER give this a NEXT_PUBLIC_ prefix and never commit it. It can read
# and write every row in the database.
SUPABASE_SERVICE_ROLE_KEY=

